datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ユーザー
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         String?
  organization String?
  bio          String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plates     Plate[]
  plateTypes PlateType[]
  conditionTemplates ConditionTemplate[]
  conditionSets      ConditionSet[]
  settings   UserSettings?
}

// ユーザー設定
model UserSettings {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  language      String  @default("en")
  appearance    String  @default("light")
  notifNewPlate Boolean @default(true)
  notifStatus   Boolean @default(true)
  notifReminder Boolean @default(false)
}

// プレート種別（ユーザーがカスタム追加可能）
model PlateType {
  id          String  @id @default(uuid())
  name        String
  rows        Int
  cols        Int
  maxDrops    Int         @default(1)
  layout      PlateLayout
  description String?
  isDefault   Boolean @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  plates Plate[]

  @@index([createdById])
}

// プレート本体
model Plate {
  id        String      @id @default(uuid())
  name      String
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  // ゴミ箱に入れた日時。NULL なら通常のプレート
  deletedAt DateTime?

  plateTypeId String
  plateType   PlateType @relation(fields: [plateTypeId], references: [id])

  reservoirTemplateId  Int?
  reservoirTemplate    ConditionTemplate? @relation("ReservoirTemplate", fields: [reservoirTemplateId], references: [id])
  screeningTemplateId  Int?
  screeningTemplate    ConditionTemplate? @relation("ScreeningTemplate", fields: [screeningTemplateId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  wells Well[]

  @@index([userId, deletedAt])
}

// プレートの中のウェル。持つのは位置だけで、記録はドロップ（Drop）が持つ
model Well {
  id       String @id @default(uuid())
  position String
  row      Int
  col      Int

  plateId String
  plate   Plate  @relation(fields: [plateId], references: [id], onDelete: Cascade)

  drops Drop[]

  @@unique([plateId, position])
}

// ウェルの中の1つの置き場所に入れたサンプル
model Drop {
  id            String        @id @default(uuid())
  wellId        String
  well          Well          @relation(fields: [wellId], references: [id], onDelete: Cascade)
  // 1〜PlateType.maxDrops。作成後は変えない
  slot          Int
  sampleName    String
  concentration String
  notes         String?       @db.Text
  observations  Observation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([wellId, slot])
}

// ドロップの観察記録（履歴）
model Observation {
  id         String   @id @default(uuid())
  dropId     String
  drop       Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  observedAt DateTime @db.Date
  notes      String   @db.Text
  createdAt  DateTime @default(now())

  @@index([dropId, observedAt])
}

enum PlateLayout {
  SITTING
  HANGING
}

// 条件セット（Reservoir + Screening テンプレートのペア）
model ConditionSet {
  id                  Int               @id @default(autoincrement())
  name                String
  isDefault           Boolean           @default(false)
  createdById         String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  reservoirTemplateId Int
  reservoirTemplate   ConditionTemplate @relation("SetReservoir", fields: [reservoirTemplateId], references: [id])
  screeningTemplateId Int
  screeningTemplate   ConditionTemplate @relation("SetScreening", fields: [screeningTemplateId], references: [id])

  @@index([isDefault])
  @@index([createdById])
}

// 条件テンプレート
model ConditionTemplate {
  id          Int    @id @default(autoincrement())
  name        String
  description String?
  isDefault   Boolean @default(false)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  reservoirPlates Plate[] @relation("ReservoirTemplate")
  screeningPlates Plate[] @relation("ScreeningTemplate")
  reservoirSets   ConditionSet[] @relation("SetReservoir")
  screeningSets   ConditionSet[] @relation("SetScreening")
  wells       TemplateWell[]

  @@index([isDefault])
  @@index([createdById])
}

// テンプレート内の各ウェル条件
model TemplateWell {
  id          Int               @id @default(autoincrement())
  templateId  Int
  template    ConditionTemplate @relation(fields: [templateId], references: [id])
  position    String
  composition String
}
